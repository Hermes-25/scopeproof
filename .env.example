PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
# PAYPAL_SANDBOX is the default. LOCAL_TEST is isolated and never moves money.
PAYMENT_MODE=PAYPAL_SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Default AI provider: free-tier Gemini. No automatic provider or model fallback.
AI_PROVIDER=GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true only after checking this key's project is Free Tier, with no billing attached.
# The app cannot determine the billing tier from an API key.
GEMINI_FREE_TIER_CONFIRMED=false
# Historical optional adapter; requires explicit AI_PROVIDER=OPENAI. Do not buy credits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional trusted Chromium executable; otherwise install with npx playwright install chromium.
# PREVIEW_BROWSER_PATH=
# Set a long random value before sharing the server. Otherwise a local secret is generated in data/.
AUTH_SECRET=
# Optional: a private data directory outside a web/public folder.
# DATA_DIR=
